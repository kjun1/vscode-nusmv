{
  "name": "vscode-nusmv",
  "displayName": "NuSMV (LiCRuM)",
  "description": "NuSMV extension for VSCode powered by Langium",
  "version": "0.12.0",
  "publisher": "LiCRuM",
  "license": "EPL-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjun1/vscode-nusmv.git",
    "directory": "langium-nusmv"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension/main.js",
  "contributes": {
    "semanticTokenScopes": [
      {
        "language": "nusmv",
        "scopes": {
          "property": [
            "variable.other.property.nusmv",
            "variable.other.property"
          ],
          "property:declaration": [
            "entity.name.variable.nusmv",
            "entity.name.variable"
          ],
          "parameter": [
            "variable.parameter.nusmv",
            "variable.parameter"
          ],
          "function": [
            "entity.name.function.nusmv",
            "entity.name.function"
          ],
          "enumMember": [
            "constant.other.enum.nusmv",
            "constant.other.enum"
          ]
        }
      }
    ],
    "configuration": {
      "title": "NuSMV",
      "properties": {
        "nusmv.disableSemanticChecksOnLargeFiles": {
          "type": "boolean",
          "default": true,
          "description": "Disable NuSMV language-server semantic checks for files above the configured line threshold."
        },
        "nusmv.semanticChecksMaxLines": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum line count for NuSMV language-server semantic checks when large-file semantic checks are disabled."
        },
        "nusmv.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the NuSMV executable. Leave empty to use 'nusmv' or 'NuSMV' on PATH ('nusmv.exe' on Windows)."
        },
        "nusmv.defaultRunArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Default command-line arguments to pass to NuSMV before the model file, for example ['-dcx']."
        },
        "nusmv.revealRunOutput": {
          "type": "string",
          "enum": [
            "always",
            "onFailure",
            "never"
          ],
          "default": "always",
          "description": "When to reveal the NuSMV Run output channel after running a model."
        }
      }
    },
    "languages": [
      {
        "id": "nusmv",
        "aliases": [
          "NuSMV"
        ],
        "extensions": [
          ".smv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nusmv",
        "scopeName": "source.nusmv",
        "path": "./syntaxes/nusmv.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nusmv.findSpecificationUses",
          "when": "editorLangId == nusmv && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nusmv.findSpecificationUses",
          "when": "editorLangId == nusmv && resourceScheme == file"
        },
        {
          "command": "nusmv.runCurrent",
          "when": "editorLangId == nusmv"
        },
        {
          "command": "nusmv.runCurrentInTerminal",
          "when": "editorLangId == nusmv"
        }
      ]
    },
    "commands": [
      {
        "command": "nusmv.findSpecificationUses",
        "title": "NuSMV: Find Specifications Using Symbol"
      },
      {
        "command": "nusmv.createTerminal",
        "title": "NuSMV: New Interactive Shell"
      },
      {
        "command": "nusmv.runCurrent",
        "title": "NuSMV: Run Current Model"
      },
      {
        "command": "nusmv.runCurrentInTerminal",
        "title": "NuSMV: Run Current Model in Terminal"
      }
    ],
    "keybindings": [
      {
        "command": "nusmv.createTerminal",
        "key": "ctrl+i",
        "mac": "cmd+i"
      },
      {
        "command": "nusmv.runCurrent",
        "key": "ctrl+r",
        "mac": "cmd+r"
      }
    ]
  },
  "scripts": {
    "langium:generate": "langium generate",
    "build": "npm run langium:generate && tsc -p tsconfig.json",
    "pretest": "node -e \"require('node:fs').rmSync('out-test', { recursive: true, force: true })\"",
    "test": "npm run langium:generate && tsc -p tests && node --test \"out-test/tests/**/*.test.js\"",
    "watch": "tsc -w -p tsconfig.json",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "langium": "^4.2.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "langium-cli": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
